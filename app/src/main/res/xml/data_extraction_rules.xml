<?xml version="1.0" encoding="utf-8"?><!--
   Minimal hardening: the shared preferences file contains the
   Wi-Fi Direct passphrase, so it is excluded from cloud backup (Android 12+/API 31+)
   and from device-to-device transfer.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="linkhelm_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="linkhelm_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
